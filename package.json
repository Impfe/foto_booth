{
  "name": "photobooth-ipad",
  "version": "0.1.0",
  "private": true,
  "description": "Fotobox-Web-App (PWA) fuers iPad: Countdown, Fotostreifen, Filter, QR-Sharing, Galerie-Export",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "booth": "bash scripts/start-booth.sh",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "cert": "bash scripts/gen-cert.sh",
    "icons": "node scripts/gen-icons.mjs",
    "mails": "node --env-file-if-exists=.env scripts/send-mails.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "nodemailer": "^9.1.1",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
