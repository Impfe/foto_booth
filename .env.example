# Port des Servers (Standard: 8443 mit HTTPS, 8080 ohne)
PORT=8443

# Verzeichnis fuer gespeicherte Fotos (Standard: ./data)
DATA_DIR=./data

# Pfade zu TLS-Zertifikat und -Key. Wenn beide existieren, startet der
# Server mit HTTPS - zwingend noetig, damit Safari die Kamera freigibt.
# Erzeugen mit: npm run cert
TLS_CERT=./certs/cert.pem
TLS_KEY=./certs/key.pem

# Optional: feste oeffentliche Adresse fuer die QR-Codes.
# Leer lassen = wird automatisch aus der Anfrage abgeleitet (empfohlen im WLAN).
PUBLIC_URL=

# Optional: Passwort fuer die Galerie (/gallery). Leer = kein Schutz.
GALLERY_PASSWORD=
